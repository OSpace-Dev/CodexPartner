{
  "name": "codex-partner",
  "displayName": "Codex Partner",
  "description": "Generate workspace file and line references for pasting into the official Codex VS Code extension.",
  "version": "0.2.0",
  "publisher": "local-development",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexPartner.copySelectionReference",
    "onCommand:codexPartner.copyFileReference",
    "onCommand:codexPartner.copyDirectoryReference"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexPartner.copySelectionReference",
        "title": "复制 Codex 文件行号引用",
        "category": "Codex Partner"
      },
      {
        "command": "codexPartner.copyFileReference",
        "title": "复制 Codex 文件引用",
        "category": "Codex Partner"
      },
      {
        "command": "codexPartner.copyDirectoryReference",
        "title": "复制 Codex 目录引用",
        "category": "Codex Partner"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexPartner.copySelectionReference",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "navigation@50"
        }
      ],
      "explorer/context": [
        {
          "command": "codexPartner.copyFileReference",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@50"
        },
        {
          "command": "codexPartner.copyDirectoryReference",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/editor-reference.js && node --check src/reference-format.js && node --test test/*.test.js"
  }
}