{
  "name": "codex-partner",
  "displayName": "%codexPartner.displayName%",
  "description": "%codexPartner.description%",
  "version": "0.5.0",
  "icon": "media/icon.png",
  "publisher": "OSpace-Dev",
  "license": "MIT",
  "homepage": "https://github.com/OSpace-Dev/CodexPartner#readme",
  "bugs": {
    "url": "https://github.com/OSpace-Dev/CodexPartner/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OSpace-Dev/CodexPartner.git"
  },
  "keywords": [
    "codex",
    "context",
    "reference",
    "productivity",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexPartner.copySelectionReference",
    "onCommand:codexPartner.copyFileReference",
    "onCommand:codexPartner.copyDirectoryReference",
    "onCommand:codexPartner.searchAndCopyReference",
    "onCommand:codexPartner.openKeybindings"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "codexPartner.copySelectionReference",
        "title": "%codexPartner.commands.copySelectionReference%",
        "category": "%codexPartner.category%"
      },
      {
        "command": "codexPartner.copyFileReference",
        "title": "%codexPartner.commands.copyFileReference%",
        "category": "%codexPartner.category%"
      },
      {
        "command": "codexPartner.copyDirectoryReference",
        "title": "%codexPartner.commands.copyDirectoryReference%",
        "category": "%codexPartner.category%"
      },
      {
        "command": "codexPartner.searchAndCopyReference",
        "title": "%codexPartner.commands.searchAndCopyReference%",
        "category": "%codexPartner.category%"
      },
      {
        "command": "codexPartner.openKeybindings",
        "title": "%codexPartner.commands.openKeybindings%",
        "category": "%codexPartner.category%"
      }
    ],
    "keybindings": [
      {
        "command": "codexPartner.copySelectionReference",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "codexPartner.copyFileReference",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus && !editorHasSelection && resourceScheme == file"
      },
      {
        "command": "codexPartner.searchAndCopyReference",
        "key": "ctrl+alt+r"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexPartner.copySelectionReference",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "navigation@50"
        }
      ],
      "explorer/context": [
        {
          "command": "codexPartner.copyFileReference",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@50"
        },
        {
          "command": "codexPartner.copyDirectoryReference",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "navigation@50"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/editor-reference.js && node --check src/localization.js && node --check src/reference-format.js && node --check src/reference-search.js && node --test test/*.test.js"
  }
}
